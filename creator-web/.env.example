# Web panel
WEB_PORT=3000
WEB_USER=admin
WEB_PASS=changeme

# Headless binaries directory (auto-detected if empty)
BINS_DIR=

# Persistent data directory
DATA_DIR=./data

# Upstream SOCKS5 proxy (forwarded to spawned creators)
UPSTREAM_SOCKS=
UPSTREAM_USER=
UPSTREAM_PASS=

# Resource mode for headless creators: default, moderate, unlimited
RESOURCES=default

# Enable debug logging
DEBUG=false

# VK Bot (optional)
VK_BOT_TOKEN=
VK_BOT_GROUP_ID=
VK_BOT_USER_IDS=
